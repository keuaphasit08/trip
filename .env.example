# Copy to frontend/.env for Vite. Leave empty to use the local Vite proxy.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Export in the backend shell only when using cross-origin hosting.
TRIPFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
